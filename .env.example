# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-your-token-here

# Как часто опрашивать фильтры (минуты). Не меньше MIN_POLL_INTERVAL_MINUTES.
POLL_INTERVAL_MINUTES=10
MIN_POLL_INTERVAL_MINUTES=5

# Лимит фильтров на одного пользователя
MAX_FILTERS_PER_USER=10

# Сколько лотов можно отслеживать сердечком
MAX_WATCHED_PER_USER=30

# Пауза между запросами к bid.cars (секунды)
REQUEST_DELAY_SECONDS=3

# Сколько страниц результатов забирать за одну проверку (50 лотов на страницу)
PARSER_MAX_PAGES=2

# После скольких ошибок подряд ставить фильтр на паузу
PARSE_FAILURE_THRESHOLD=5

# Максимум карточек, которые бот пришлёт за одну проверку одного фильтра
MAX_NOTIFY_PER_FILTER=15

# SQLite. В Docker путь уже прописан в compose, локально можно оставить так:
DATABASE_URL=sqlite+aiosqlite:///./data/bidcarbot.db

LOG_LEVEL=INFO
LOG_DIR=./data/logs

# Часовой пояс для дат в /status и /list_filters
TIMEZONE=Europe/Kyiv

# Подписка USDT TRC20
USDT_TRC20_WALLET=TKXbcn4tpzudTc66CP65prmE6rcgmTybAs
SUB_MONTH_USDT=5
SUB_YEAR_USDT=50

# Пароль скрытой команды /set_god_mode {telegram_id}
GOD_MODE_PASSWORD=814***

# Необязательно: ключ TronGrid, если публичный лимит начнёт резать запросы
# TRONGRID_API_KEY=
